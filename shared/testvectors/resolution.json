{
  "vectorSet": "resolution",
  "description": "Trigger to absolute UTC target instant. Both implementations must agree exactly.",
  "cases": [
    {
      "id": "indefinite-has-no-target",
      "description": "An indefinite keep-awake job has no target instant by design.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "indefinite" },
      "expectedTargetInstantUtc": null
    },
    {
      "id": "duration-two-hours",
      "description": "A duration is now plus the duration.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "duration", "minutes": 120 },
      "expectedTargetInstantUtc": "2026-07-30T09:00:00Z"
    },
    {
      "id": "duration-one-minute-minimum",
      "description": "The smallest accepted duration still resolves normally.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "duration", "minutes": 1 },
      "expectedTargetInstantUtc": "2026-07-30T07:01:00Z"
    },
    {
      "id": "duration-maximum-24h",
      "description": "1440 minutes is exactly 24 hours and is accepted.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "duration", "minutes": 1440 },
      "expectedTargetInstantUtc": "2026-07-31T07:00:00Z"
    },
    {
      "id": "duration-ignores-timezone-saigon",
      "description": "A duration is anchored at creation, so the zone must not affect it. Paired with duration-ignores-timezone-newyork: same now, same duration, different zone, identical expected result.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "duration", "minutes": 90 },
      "expectedTargetInstantUtc": "2026-07-30T08:30:00Z"
    },
    {
      "id": "duration-ignores-timezone-newyork",
      "description": "Same inputs as duration-ignores-timezone-saigon but in a DST zone; the target must be identical.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "America/New_York",
      "trigger": { "kind": "duration", "minutes": 90 },
      "expectedTargetInstantUtc": "2026-07-30T08:30:00Z"
    },
    {
      "id": "duration-crosses-dst-spring-forward",
      "description": "A duration spanning a spring-forward transition adds real elapsed time, not wall-clock time. 23:30 EST on Mar 7 plus 240 minutes lands at 03:30 EDT on Mar 8.",
      "now": "2026-03-08T04:30:00Z",
      "timezone": "America/New_York",
      "trigger": { "kind": "duration", "minutes": 240 },
      "expectedTargetInstantUtc": "2026-03-08T08:30:00Z"
    },
    {
      "id": "absolute-future-today",
      "description": "14:00 local Saigon, target 20:00 the same day.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "absoluteTime", "hour": 20, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-30T13:00:00Z"
    },
    {
      "id": "absolute-past-rolls-to-tomorrow",
      "description": "21:00 local Saigon, target 20:00 already passed, so it rolls to tomorrow.",
      "now": "2026-07-30T14:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "absoluteTime", "hour": 20, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-31T13:00:00Z"
    },
    {
      "id": "absolute-equal-to-now-rolls-to-tomorrow",
      "description": "The target must be strictly in the future; a job created at exactly 20:00 for 20:00 must not fire instantly.",
      "now": "2026-07-30T13:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "absoluteTime", "hour": 20, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-31T13:00:00Z"
    },
    {
      "id": "absolute-one-minute-before-rolls-forward-not-back",
      "description": "One minute before the target, it still resolves to today rather than rolling.",
      "now": "2026-07-30T12:59:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "absoluteTime", "hour": 20, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-30T13:00:00Z"
    },
    {
      "id": "absolute-midnight",
      "description": "00:00 is a valid wall time and rolls to the next day when already past.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Ho_Chi_Minh",
      "trigger": { "kind": "absoluteTime", "hour": 0, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-30T17:00:00Z"
    },
    {
      "id": "absolute-spring-forward-gap",
      "description": "America/New_York 2026-03-08: the clock goes 02:00 to 03:00, so 02:30 does not exist. It must resolve to the instant the clock jumps to, 03:00 EDT.",
      "now": "2026-03-08T06:00:00Z",
      "timezone": "America/New_York",
      "trigger": { "kind": "absoluteTime", "hour": 2, "minute": 30 },
      "expectedTargetInstantUtc": "2026-03-08T07:00:00Z"
    },
    {
      "id": "absolute-fall-back-overlap-takes-earlier",
      "description": "America/New_York 2026-11-01: the clock goes 02:00 back to 01:00, so 01:30 occurs twice at 05:30Z and 06:30Z. It must resolve to the earlier one.",
      "now": "2026-11-01T04:00:00Z",
      "timezone": "America/New_York",
      "trigger": { "kind": "absoluteTime", "hour": 1, "minute": 30 },
      "expectedTargetInstantUtc": "2026-11-01T05:30:00Z"
    },
    {
      "id": "absolute-in-half-hour-offset-zone",
      "description": "A zone with a 30-minute offset must resolve correctly. Asia/Kolkata is UTC+5:30, so 22:00 local is 16:30Z.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Kolkata",
      "trigger": { "kind": "absoluteTime", "hour": 22, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-30T16:30:00Z"
    },
    {
      "id": "absolute-in-nepal-45-minute-offset",
      "description": "Asia/Kathmandu is UTC+5:45, an offset that is neither whole nor half hours.",
      "now": "2026-07-30T07:00:00Z",
      "timezone": "Asia/Kathmandu",
      "trigger": { "kind": "absoluteTime", "hour": 23, "minute": 0 },
      "expectedTargetInstantUtc": "2026-07-30T17:15:00Z"
    }
  ]
}
