<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Permissions required for Weakup -->

    <!-- Foreground service permission (all API levels) -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />

    <!-- Required on API 34+ (Android 14+) to avoid MissingForegroundServiceTypeException.
         Must match android:foregroundServiceType="dataSync" on the service element. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Runtime notification permission for Android 13+ (API 33+) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Exact alarm scheduling permission (Android 12+, denied by default on 13+) -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

    <!-- Wake-lock for keeping the screen awake -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Receive boot completed broadcast to re-register pending jobs after reboot -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:label="weakup"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Foreground service for keeping jobs running while the app is in the background.
             android:foregroundServiceType="dataSync" is REQUIRED on API 34+ (Android 14+).
             This must match the serviceTypes passed at runtime via flutter_foreground_task,
             or startForeground() will throw MissingForegroundServiceTypeException. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundTaskService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Boot receiver to re-register pending jobs after device reboot. -->
        <receiver
            android:name="com.weakup.weakup.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
